    // SUPABASE CLIENT INITIALIZATION
    let supabaseClient = null;
    function initSupabase() {
      const url = localStorage.getItem('bpg_sb_url') || '';
      const key = localStorage.getItem('bpg_sb_key') || '';
      if (url && key && window.supabase) {
        supabaseClient = window.supabase.createClient(url, key);
      }
    }

    // LOCAL STORAGE FALLBACK DATA STORE
    function getLocalSubmissions() {
      const data = localStorage.getItem('bpg_local_submissions');
      return data ? JSON.parse(data) : [];
    }

    function saveLocalSubmission(sub) {
      const list = getLocalSubmissions();
      list.push(sub);
      localStorage.setItem('bpg_local_submissions', JSON.stringify(list));
    }

    // RENDER QUESTIONS IN FORMS
    function renderQuizzes() {
      ['pra', 'pasca'].forEach(type => {
        const container = document.getElementById(`quiz-container-${type}`);
        container.innerHTML = '';
        QUIZ_QUESTIONS.forEach((item, idx) => {
          const card = document.createElement('div');
          card.className = 'p-5 bg-slate-50 rounded-xl border border-slate-200';
          card.innerHTML = `
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-bold text-slate-400">SOALAN ${item.no} DARI 10</span>
              <span class="text-[11px] font-semibold px-2 py-0.5 rounded bg-slate-200 text-slate-700">${item.slot}</span>
            </div>
            <p class="font-semibold text-slate-800 text-sm mb-3">${item.q}</p>
            <div class="space-y-2">
              ${item.options.map(opt => `
                <label class="flex items-start space-x-3 p-3 bg-white rounded-lg border border-slate-200 hover:border-bpg-blue cursor-pointer transition text-xs sm:text-sm">
                  <input type="radio" name="${type}_q${item.no}" value="${opt.key}" required class="mt-0.5 text-bpg-blue focus:ring-bpg-blue">
                  <span class="text-slate-700"><strong class="text-slate-900">${opt.key}.</strong> ${opt.text}</span>
                </label>
              `).join('')}
            </div>
          `;
          container.appendChild(card);
        });
      });
    }

    // SUBMIT QUIZ
    async function submitQuiz(e, testType) {
      e.preventDefault();
      const prefix = testType.toLowerCase() === 'pre' ? 'pra' : 'pasca';
      const form = document.getElementById(`form-${prefix}`);
      const btn = document.getElementById(`btn-submit-${prefix}`);

      btn.disabled = true;
      btn.textContent = 'Memproses...';

      let score = 0;
      const row = {
        jenis_ujian: testType,
        created_at: new Date().toISOString()
      };

      QUIZ_QUESTIONS.forEach(item => {
        const selected = form.querySelector(`input[name="${prefix}_q${item.no}"]:checked`);
        const isCorrect = (selected && selected.value === item.ans) ? 1 : 0;
        if (isCorrect) score++;
        row[`q${item.no}`] = isCorrect;
      });
      row.skor_total = score;

      // 1. Send to Supabase if configured
      if (supabaseClient) {
        try {
          const { error } = await supabaseClient.from('jawapan_kuiz').insert([row]);
          if (error) console.error('Supabase error:', error);
        } catch (err) {
          console.error('Supabase exception:', err);
        }
      }

      // 2. Also save to LocalStorage so it works 100% offline or immediately
      saveLocalSubmission(row);

      // 3. UI Update
      form.classList.add('hidden');
      const resBox = document.getElementById(`result-box-${prefix}`);
      document.getElementById(`score-display-${prefix}`).textContent = `${score} / 10`;
      resBox.classList.remove('hidden');

      // Refresh aggregate dashboard
      calculateAggregates();
    }

    // CALCULATE AGGREGATES dan RENDER DASHBOARD
    async function calculateAggregates() {
      let data = [];

      if (supabaseClient) {
        try {
          const { data: sbData, error } = await supabaseClient.from('jawapan_kuiz').select('*');
          if (!error && sbData && sbData.length > 0) {
            data = sbData;
          } else {
            data = getLocalSubmissions();
          }
        } catch (e) {
          data = getLocalSubmissions();
        }
      } else {
        data = getLocalSubmissions();
      }

      const preList = data.filter(d => d.jenis_ujian === 'PRE');
      const postList = data.filter(d => d.jenis_ujian === 'POST');

      const preCount = preList.length;
      const postCount = postList.length;

      document.getElementById('stat-count-pre').textContent = preCount;
      document.getElementById('stat-count-post').textContent = postCount;

      const preAvg = preCount > 0 ? (preList.reduce((acc, c) => acc + (c.skor_total || 0), 0) / preCount) : 0;
      const postAvg = postCount > 0 ? (postList.reduce((acc, c) => acc + (c.skor_total || 0), 0) / postCount) : 0;

      document.getElementById('stat-avg-pre').textContent = preAvg.toFixed(1);
      document.getElementById('stat-pct-pre').textContent = `${(preAvg * 10).toFixed(0)}% ketepatan asas`;

      document.getElementById('stat-avg-post').textContent = postAvg.toFixed(1);
      document.getElementById('stat-pct-post').textContent = `${(postAvg * 10).toFixed(0)}% ketepatan akhir`;

      const diff = postAvg - preAvg;
      const diffEl = document.getElementById('stat-diff-score');
      diffEl.textContent = (diff >= 0 ? `+${diff.toFixed(1)}` : diff.toFixed(1));
      diffEl.className = diff >= 0 ? 'text-3xl font-extrabold text-emerald-600' : 'text-3xl font-extrabold text-red-600';

      const pctDiff = preAvg > 0 ? (((postAvg - preAvg) / preAvg) * 100).toFixed(1) : 0;
      document.getElementById('stat-diff-percent').textContent = (diff >= 0 ? `+${pctDiff}%` : `${pctDiff}%`) + ' perbezaan purata';

      // Render Item-by-item Table
      const tbody = document.getElementById('breakdown-table-body');
      tbody.innerHTML = '';

      QUIZ_QUESTIONS.forEach(item => {
        const qKey = `q${item.no}`;
        const preCorrect = preCount > 0 ? preList.filter(d => d[qKey] === 1).length : 0;
        const postCorrect = postCount > 0 ? postList.filter(d => d[qKey] === 1).length : 0;

        const prePct = preCount > 0 ? ((preCorrect / preCount) * 100) : 0;
        const postPct = postCount > 0 ? ((postCorrect / postCount) * 100) : 0;
        const itemDiff = postPct - prePct;

        const tr = document.createElement('tr');
        tr.className = 'hover:bg-slate-50 transition';

        let badge = '';
        if (itemDiff > 0) {
          badge = `<span class="inline-flex items-center text-xs font-bold text-emerald-700 bg-emerald-100 px-2.5 py-1 rounded-full">+${itemDiff.toFixed(1)}%</span>`;
        } else if (itemDiff < 0) {
          badge = `<span class="inline-flex items-center text-xs font-bold text-red-700 bg-red-100 px-2.5 py-1 rounded-full">${itemDiff.toFixed(1)}%</span>`;
        } else {
          badge = `<span class="inline-flex items-center text-xs font-medium text-slate-500 bg-slate-100 px-2.5 py-1 rounded-full">0.0%</span>`;
        }

        tr.innerHTML = `
          <td class="p-4 text-center font-bold text-slate-400">${item.no}</td>
          <td class="p-4">
            <span class="font-bold text-slate-800 block text-xs sm:text-sm">${item.topic}</span>
            <span class="text-xs text-slate-500 line-clamp-1">${item.q}</span>
          </td>
          <td class="p-4 text-center text-xs font-semibold text-slate-600">${item.slot}</td>
          <td class="p-4 text-center font-semibold text-slate-700">${prePct.toFixed(0)}% <span class="text-[10px] text-slate-400 block">(${preCorrect}/${preCount})</span></td>
          <td class="p-4 text-center font-bold text-emerald-700">${postPct.toFixed(0)}% <span class="text-[10px] text-slate-400 block">(${postCorrect}/${postCount})</span></td>
          <td class="p-4 text-center">${badge}</td>
        `;
        tbody.appendChild(tr);
      });
    }

    // TAB SWITCHING
    function switchTab(tabId) {
      document.querySelectorAll('.tab-view').forEach(el => el.classList.add('hidden'));
      document.querySelectorAll('.nav-tab').forEach(el => {
        el.classList.remove('bg-white/20', 'shadow');
        el.classList.add('hover:bg-white/10', 'text-white/80');
      });

      document.getElementById(`view-${tabId}`).classList.remove('hidden');
      const activeBtn = document.getElementById(`tab-${tabId}`);
      activeBtn.classList.add('bg-white/20', 'shadow');
      activeBtn.classList.remove('hover:bg-white/10', 'text-white/80');

      if (tabId === 'analisis') {
        calculateAggregates();
      }
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // READING SLOT SWITCHING
    function showSlot(slotId) {
      document.querySelectorAll('.slot-content').forEach(el => el.classList.add('hidden'));
      document.querySelectorAll('.slot-btn').forEach(el => {
        el.classList.remove('bg-bpg-navy', 'text-white', 'shadow');
        el.classList.add('hover:bg-slate-100', 'text-slate-700');
      });

      document.getElementById(`content-${slotId}`).classList.remove('hidden');
      const activeBtn = document.getElementById(`btn-${slotId}`);
      activeBtn.classList.add('bg-bpg-navy', 'text-white', 'shadow');
      activeBtn.classList.remove('hover:bg-slate-100', 'text-slate-700');
    }

    // MODAL dan CONFIG
    function toggleConfigModal() {
      const modal = document.getElementById('config-modal');
      modal.classList.toggle('hidden');
      if (!modal.classList.contains('hidden')) {
        document.getElementById('cfg-url').value = localStorage.getItem('bpg_sb_url') || '';
        document.getElementById('cfg-key').value = localStorage.getItem('bpg_sb_key') || '';
      }
    }

    function saveSupabaseConfig() {
      const url = document.getElementById('cfg-url').value.trim();
      const key = document.getElementById('cfg-key').value.trim();
      localStorage.setItem('bpg_sb_url', url);
      localStorage.setItem('bpg_sb_key', key);
      initSupabase();
      toggleConfigModal();
      calculateAggregates();
      alert('Tetapan Supabase telah disimpan dan dimuat semula!');
    }

    function refreshData() {
      calculateAggregates();
    }

    // INITIALIZATION
    
    // Buka tetapan tersembunyi (Tekan Ctrl + Shift + S)
    window.addEventListener('keydown', (e) => {
      if (e.ctrlKey && e.shiftKey && (e.key === 'S' || e.key === 's')) {
        toggleConfigModal();
      }
    });

    window.addEventListener('DOMContentLoaded', () => {
      initSupabase();
      renderQuizzes();
      calculateAggregates();
    });
  </script>
